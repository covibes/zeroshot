{
  "provider": "openrouter",
  "harness": "claude",
  "model": "claude-haiku-4-5",
  "environment": {
    "ANTHROPIC_API_KEY": "",
    "ANTHROPIC_AUTH_TOKEN": { "from": "OPENROUTER_API_KEY" },
    "ANTHROPIC_BASE_URL": "https://openrouter.ai/api"
  },
  "files": {},
  "settings": {
    "defaultProvider": "claude",
    "providerSettings": {
      "claude": {
        "minLevel": "level1",
        "defaultLevel": "level1",
        "maxLevel": "level1",
        "levelOverrides": {
          "level1": { "model": "claude-haiku-4-5" }
        }
      }
    }
  }
}
