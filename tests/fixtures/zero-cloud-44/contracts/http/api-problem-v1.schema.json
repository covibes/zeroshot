{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ApiProblemV1",
  "type": "object",
  "properties": {
    "code": {
      "$ref": "#/$defs/ProblemCodeV1"
    },
    "message": {
      "type": "string"
    }
  },
  "required": [
    "code",
    "message"
  ],
  "$defs": {
    "ProblemCodeV1": {
      "type": "string",
      "enum": [
        "unauthorized",
        "invalid_request",
        "not_found",
        "forbidden",
        "idempotency_conflict",
        "run_conflict",
        "rate_limited",
        "temporarily_unavailable",
        "internal_error"
      ]
    }
  },
  "additionalProperties": true
}
