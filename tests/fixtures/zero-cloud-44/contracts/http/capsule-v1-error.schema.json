{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CapsuleErrorV1",
  "type": "object",
  "properties": {
    "code": {
      "$ref": "#/$defs/ProblemCodeV1"
    },
    "message": {
      "type": "string"
    },
    "capsule_id": {
      "type": ["string", "null"]
    },
    "retryable": {
      "type": "boolean"
    }
  },
  "additionalProperties": false,
  "required": ["code", "message", "capsule_id", "retryable"],
  "$defs": {
    "ProblemCodeV1": {
      "type": "string",
      "enum": [
        "unauthorized",
        "invalid_request",
        "not_found",
        "forbidden",
        "idempotency_conflict",
        "run_conflict",
        "rate_limited",
        "temporarily_unavailable",
        "internal_error"
      ]
    }
  }
}
